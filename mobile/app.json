{
  "expo": {
    "name": "Dami's Lifestyle",
    "slug": "damis-lifestyle",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "damis",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFFCE0",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.damis.lifestyle"
    },
    "android": {
      "package": "com.damis.lifestyle"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-web-browser", "expo-secure-store"],
    "extra": {
      "eas": { "projectId": "replace-with-your-eas-project-id" }
    }
  }
}